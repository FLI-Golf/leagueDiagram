{
  "name": "leage-diogram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "demo:fantasy": "playwright test fantasy-owner-intro",
    "demo:fantasy:headed": "xvfb-run -a playwright test fantasy-owner-intro --headed",
    "demo:fill-league": "playwright test fill-the-league",
    "demo:draft": "playwright test draft-walkthrough",
    "demo:entity-map": "playwright test entity-map-tour",
    "demo:entity-map:league": "DIAGRAM_VIEW=league playwright test entity-map-tour",
    "demo:entity-map:fantasy": "DIAGRAM_VIEW=fantasy playwright test entity-map-tour",
    "demo:entity-map:course": "DIAGRAM_VIEW=course playwright test entity-map-tour",
    "demo:entity-map:sponsorship": "DIAGRAM_VIEW=sponsorship playwright test entity-map-tour",
    "demo:entity-map:pipelines": "DIAGRAM_VIEW=pipelines playwright test entity-map-tour",
    "demo:entity-map:overview": "DIAGRAM_VIEW=overview playwright test entity-map-tour"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "mermaid": "^11.17.2"
  }
}
